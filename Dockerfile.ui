FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

COPY requirements.ui.txt .
RUN pip install --no-cache-dir -r requirements.ui.txt

COPY ui/ ./ui/

RUN mkdir -p /app/reports

# Create Streamlit config 
RUN mkdir -p /root/.streamlit && cat > /root/.streamlit/config.toml << 'EOF'
[server]
address = "0.0.0.0"
port = 8501
headless = true

[client]
showErrorDetails = true

[logger]
level = "info"

[browser]
gatherUsageStats = false
EOF

# Create a test script to validate imports and show errors
RUN cat > /app/entrypoint.sh << 'EOF'
#!/bin/bash
set -e
echo "=== Testing Python imports ==="
python3 -c "import sys; sys.path.insert(0, '.'); from ui import app; print('✓ UI module imports successfully')" 2>&1 || (echo "✗ Import failed:" && python3 -c "import sys; sys.path.insert(0, '.'); from ui import app" && exit 1)
echo "=== Starting Streamlit ==="
echo ""
echo "╔════════════════════════════════════════════════════╗"
echo "║  ESG Integrity Auditor - Streamlit UI is ready!    ║"
echo "║                                                    ║"
echo "║  Access from browser at:  http://localhost:8501   ║"
echo "║  (Or your.remote.ip:8501 if accessing remotely)   ║"
echo "╚════════════════════════════════════════════════════╝"
echo ""
exec streamlit run ui/app.py 2>&1 | sed 's|http://0.0.0.0:8501|http://localhost:8501|g'
EOF
RUN sed -i 's/\r$//' /app/entrypoint.sh && chmod +x /app/entrypoint.sh

EXPOSE 8501

CMD ["/app/entrypoint.sh"]
